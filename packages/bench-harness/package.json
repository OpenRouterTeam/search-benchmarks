{
  "name": "@openrouter/bench-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone OpenRouter search benchmark harness",
  "type": "module",
  "exports": {
    "./benchmarks/benchmark-config": "./benchmarks/benchmark-config.ts",
    "./benchmarks/benchmark-meta": "./benchmarks/benchmark-meta.ts",
    "./benchmarks/registry": "./benchmarks/registry.ts",
    "./benchmarks/search/core/config": "./benchmarks/search/core/config.ts",
    "./core": "./core.ts",
    "./parquet": "./parquet.ts",
    "./parquet-schema": "./parquet-schema.ts",
    "./progress": "./progress.ts",
    "./run": "./run.ts",
    "./run-benchmark-by-id": "./run-benchmark-by-id.ts"
  },
  "scripts": {
    "bench": "bun run bench.ts",
    "publish": "bun run publish-run.ts",
    "run": "bun run cli.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform": "0.95.0",
    "@openrouter/sdk": "1.1.19",
    "chrono-node": "2.9.0",
    "csv-parse": "5.6.0",
    "effect": "3.20.0",
    "hyparquet": "1.26.1",
    "hyparquet-writer": "0.16.1",
    "smol-toml": "1.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "license": "MIT"
}
